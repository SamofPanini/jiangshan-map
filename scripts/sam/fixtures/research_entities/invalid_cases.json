[
 {
  "case": "ID 前缀与对象种类不符",
  "expect": "E_ID_PREFIX",
  "file": "registry/institutions.jsonl",
  "patch": [
   {
    "op": "replace",
    "path": "/0/id",
    "value": "den:cn-t1"
   }
  ]
 },
 {
  "case": "ID 重复",
  "expect": "E_DUP_ID",
  "file": "registry/persons.jsonl",
  "patch": [
   {
    "op": "replace",
    "path": "/1/id",
    "value": "per:cn-m1"
   }
  ]
 },
 {
  "case": "claim 指向不存在的机构",
  "expect": "E_REF",
  "file": "layers/cn-synthetic/claims.jsonl",
  "patch": [
   {
    "op": "replace",
    "path": "/0/subject",
    "value": "tmp:cn-zz"
   }
  ]
 },
 {
  "case": "谓词主宾种类不符：abbot_of 宾语是人物",
